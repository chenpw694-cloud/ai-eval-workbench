    { "code": "A-04", "name": "文字不可读 / 版面混乱", "dimension": "A", "severity": "P2" },
    { "code": "A-05", "name": "上架规范不符", "dimension": "A", "severity": "P2" },
    { "code": "A-06", "name": "抠图感 / 悬浮感", "dimension": "A", "severity": "P2" },
    { "code": "A-07", "name": "细节不清", "dimension": "A", "severity": "P2" },
    { "code": "A-08", "name": "卖点表达错误", "dimension": "A", "severity": "P1" },
    { "code": "B-01", "name": "主体错误", "dimension": "B", "severity": "P1" },
