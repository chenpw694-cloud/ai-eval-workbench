    { "code": "B-05", "name": "构图 / 视角不符", "dimension": "B", "severity": "P2" },
    { "code": "C-01", "name": "真实感不足", "dimension": "C", "severity": "P2" },
    { "code": "C-02", "name": "结构畸形", "dimension": "C", "severity": "P1" },
    { "code": "C-03", "name": "清晰度不足", "dimension": "C", "severity": "P2" },
    { "code": "C-04", "name": "缺乏商业美感", "dimension": "C", "severity": "P2" },
